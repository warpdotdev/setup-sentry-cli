{
  "name": "@mathieu-bour/setup-sentry-cli",
  "version": "2.0.0",
  "description": "Install the Sentry CLI in your GitHub Actions workflow.",
  "keywords": ["github-actions", "actions", "sentry", "sentry-cli", "sentry-release"],
  "homepage": "https://github.com/mathieu-bour/setup-sentry-cli",
  "bugs": "https://github.com/mathieu-bour/setup-sentry-cli/issues",
  "license": "MIT",
  "main": "dist/main.js",
  "author": "Mathieu Bour <mathieu@bour.tech>",
  "scripts": {
    "clean": "rimraf dist",
    "lint": "biome ci .",
    "depcheck": "depcheck",
    "typecheck": "tsc --noEmit",
    "prebuild": "pnpm clean",
    "build": "tsup"
  },
  "dependencies": {
    "@actions/core": "^1.10.1",
    "@actions/io": "^1.1.3",
    "@actions/tool-cache": "^2.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.5.3",
    "@types/node": "^20.11.24",
    "depcheck": "^1.4.7",
    "lefthook": "^1.6.4",
    "rimraf": "^5.0.5",
    "standard-commit": "^4.2.6",
    "tsup": "^8.0.2",
    "typescript": "^5.3.3"
  },
  "os": ["linux", "darwin", "win32"],
  "private": true,
  "pnpm": {
    "overrides": {
      "undici": "6.28.1",
      "braces": "3.0.3",
      "glob@10": "10.5.0",
      "minimatch@3": "3.1.3",
      "minimatch@7": "7.4.8",
      "minimatch@9": "9.0.7",
      "brace-expansion@1": "1.1.16",
      "brace-expansion@2": "2.1.2",
      "js-yaml@3": "3.15.1",
      "postcss": "8.5.18",
      "rollup": "4.59.0",
      "lodash": "4.18.1"
    }
  }
}
